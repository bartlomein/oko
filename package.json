{
  "name": "oko",
  "version": "0.1.0",
  "description": "A small code search CLI with TypeSafe AI Jev reranking.",
  "type": "module",
  "bin": {
    "oko": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/*.test.js scripts/*.test.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "dotenv": "^18.0.0",
    "stemmer": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
